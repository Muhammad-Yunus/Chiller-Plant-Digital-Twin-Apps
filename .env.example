# Server runtime
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS=""

# Option A (Recommended): Supabase PostgreSQL Pooler Connection String (Session :5432 or Transaction :6543)
# Store actual credentials only in local gitignored .env or Cloud Secret Manager
SUPABASE_DB_URL=""
SUPABASE_ADMIN_DB_URL=""

# Option B (Split variables, backward-compatible)
SQL_HOST="change-me"
SQL_PORT="5432"
SQL_DB_NAME="postgres"
SQL_USER="change-me"
SQL_PASSWORD=""
SQL_ADMIN_USER="change-me"
SQL_ADMIN_PASSWORD=""

# TLS Configuration (recommended: SQL_SSL="true" and SQL_SSL_REJECT_UNAUTHORIZED="true" with SQL_SSL_CA PEM/path)
SQL_SSL="true"
SQL_SSL_REJECT_UNAUTHORIZED="true"
SQL_SSL_CA=""
SQL_POOL_MAX="10"

# Operator RBAC & Telemetry freshness
BOOTSTRAP_ADMIN_EMAIL=""
TELEMETRY_STALE_AFTER_SEC="15"

# Optional rate limiting & metrics scraping token
API_RATE_LIMIT_PER_MIN="180"
INGEST_RATE_LIMIT_PER_MIN="240"
METRICS_TOKEN=""

# Edge Gateway Simulator CLI variables (never commit real secrets or place in browser VITE_* vars)
EDGE_API_URL="http://127.0.0.1:3000"
PLANT_CODE="CENTRAL_PLANT_01"
EDGE_DEVICE_ID="gw-sim-01"
EDGE_CREDENTIAL_ID=""
EDGE_SECRET=""
