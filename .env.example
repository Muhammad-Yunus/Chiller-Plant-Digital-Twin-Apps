# Server runtime
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS=""

# PostgreSQL / Supabase / Cloud SQL runtime connection (fill in local .env or Secret Manager)
SQL_HOST="change-me"
SQL_PORT="5432"
SQL_DB_NAME="change-me"
SQL_USER="change-me"
SQL_PASSWORD=""
SQL_SSL="true"
SQL_SSL_REJECT_UNAUTHORIZED="false"
SQL_POOL_MAX="10"

# PostgreSQL migration admin user (used strictly by drizzle-kit / db:migrate)
SQL_ADMIN_USER="change-me"
SQL_ADMIN_PASSWORD=""

# Operator RBAC & Telemetry freshness
BOOTSTRAP_ADMIN_EMAIL=""
TELEMETRY_STALE_AFTER_SEC="15"

# Optional rate limiting & metrics scraping token
API_RATE_LIMIT_PER_MIN="180"
INGEST_RATE_LIMIT_PER_MIN="240"
METRICS_TOKEN=""

# Optional Gemini API key (server-side only, injected via runtime secrets)
GEMINI_API_KEY=""
