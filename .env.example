# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional comma-separated allowed CORS origins (defaults to APP_URL + localhost in dev)
ALLOWED_ORIGINS=""

# Cloud SQL / PostgreSQL runtime app user (least-privilege DML only; injected via Secrets)
SQL_HOST="/cloudsql/PROJECT:REGION:INSTANCE"
SQL_PORT=""
SQL_DB_NAME="chiller_plant_twin"
SQL_USER="app_user"
SQL_PASSWORD=""
SQL_SSL="false"
SQL_SSL_REJECT_UNAUTHORIZED="true"

# Cloud SQL / PostgreSQL migration admin user (used strictly by drizzle-kit migrations)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""

# Optional bootstrap admin email (assigned ADMIN role on default plant upon first sign-in)
BOOTSTRAP_ADMIN_EMAIL=""

# Optional staleness threshold in seconds (default 15s)
TELEMETRY_STALE_AFTER_SEC="15"
