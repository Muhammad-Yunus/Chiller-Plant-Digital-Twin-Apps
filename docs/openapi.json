{
  "openapi": "3.1.0",
  "info": {
    "title": "Chiller Plant Twin Telemetry & Control API",
    "version": "1.2.0",
    "description": "Production HVAC Digital Twin API separating Operator RBAC (Firebase ID Tokens) from IoT Edge Gateway / Simulator ingestion credentials (X-Edge-Credential-Id + X-Edge-Secret) with server-verified provenance."
  },
  "servers": [
    {
      "url": "/",
      "description": "Current deployment origin"
    }
  ],
  "components": {
    "securitySchemes": {
      "OperatorBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Firebase JWT"
      },
      "EdgeCredentialId": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Edge-Credential-Id"
      },
      "EdgeSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Edge-Secret"
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" },
              "details": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      },
      "PlantKpis": {
        "type": "object",
        "required": [
          "coolingLoadMw",
          "totalPowerMw",
          "systemCop",
          "wetBulbC",
          "chwSupplyC",
          "chwReturnC",
          "deltaTK",
          "cwSupplyC",
          "towerApproachK",
          "chillersOn"
        ],
        "properties": {
          "coolingLoadMw": { "type": "number", "minimum": 0, "maximum": 500 },
          "totalPowerMw": { "type": "number", "minimum": 0, "maximum": 200 },
          "systemCop": { "type": "number", "minimum": 0, "maximum": 15 },
          "wetBulbC": { "type": "number", "minimum": -20, "maximum": 60 },
          "chwSupplyC": { "type": "number", "minimum": -10, "maximum": 40 },
          "chwReturnC": { "type": "number", "minimum": -10, "maximum": 50 },
          "deltaTK": { "type": "number", "minimum": 0, "maximum": 40 },
          "cwSupplyC": { "type": "number", "minimum": 0, "maximum": 65 },
          "towerApproachK": { "type": "number", "minimum": 0, "maximum": 30 },
          "chillersOn": { "type": "integer", "minimum": 0, "maximum": 20 }
        }
      },
      "TelemetryIngestRequest": {
        "type": "object",
        "required": [
          "plantCode",
          "edgeDeviceId",
          "sequenceNumber",
          "payloadVersion",
          "observedAt",
          "kpis",
          "devices"
        ],
        "properties": {
          "plantCode": { "type": "string", "pattern": "^[A-Z0-9_-]{3,32}$" },
          "edgeDeviceId": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{2,64}$" },
          "batchId": { "type": "string", "minLength": 4, "maxLength": 128 },
          "sequenceNumber": { "type": "integer", "minimum": 0 },
          "payloadVersion": { "type": "string", "example": "1.0.0" },
          "observedAt": { "type": "string", "format": "date-time" },
          "scenario": {
            "type": "string",
            "enum": ["Steady State", "Peak Cooling", "Part Load", "High Wet Bulb"]
          },
          "quality": {
            "type": "string",
            "enum": ["GOOD", "UNCERTAIN", "BAD", "STALE"]
          },
          "kpis": { "$ref": "#/components/schemas/PlantKpis" },
          "devices": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": ["id", "status", "loadPct", "metrics"],
              "properties": {
                "id": { "type": "string" },
                "status": { "type": "string", "enum": ["RUNNING", "STANDBY", "ISOLATED"] },
                "quality": { "type": "string", "enum": ["GOOD", "UNCERTAIN", "BAD", "STALE"] },
                "loadPct": { "type": "number", "minimum": 0, "maximum": 120 },
                "runHours": { "type": "integer", "minimum": 0 },
                "observedAt": { "type": "string", "format": "date-time" },
                "metrics": {
                  "type": "object",
                  "additionalProperties": { "type": ["number", "string"] }
                }
              }
            }
          },
          "alarms": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": ["severity", "message"],
              "properties": {
                "deviceId": { "type": "string" },
                "severity": { "type": "string", "enum": ["INFO", "WARN", "CRIT"] },
                "message": { "type": "string", "maxLength": 240 },
                "source": { "type": "string", "maxLength": 80 },
                "dedupeKey": { "type": "string", "maxLength": 128 }
              }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Liveness check",
        "responses": {
          "200": { "description": "Server process alive" }
        }
      }
    },
    "/api/ready": {
      "get": {
        "summary": "Readiness probe (Database + Auth SDK)",
        "responses": {
          "200": { "description": "Dependencies healthy" },
          "503": { "description": "Dependencies unavailable" }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "summary": "Operational telemetry & HTTP counters",
        "security": [{ "OperatorBearerAuth": [] }],
        "responses": {
          "200": { "description": "Metrics snapshot" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/docs/openapi.json": {
      "get": {
        "summary": "OpenAPI 3.1 specification document",
        "responses": {
          "200": { "description": "OpenAPI JSON" }
        }
      }
    },
    "/api/v1/plants/{plantCode}/snapshot": {
      "get": {
        "summary": "Load full plant snapshot (KPIs, 19 devices, alarms, initial trends)",
        "security": [{ "OperatorBearerAuth": [] }],
        "parameters": [
          { "name": "plantCode", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Authorized plant snapshot" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden for plant" },
          "404": { "description": "Plant not found" }
        }
      }
    },
    "/api/v1/plants/{plantCode}/stream": {
      "get": {
        "summary": "Server-Sent Events (SSE) live telemetry stream",
        "security": [{ "OperatorBearerAuth": [] }],
        "parameters": [
          { "name": "plantCode", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "text/event-stream telemetry updates" }
        }
      }
    },
    "/api/v1/plants/{plantCode}/devices/{deviceId}/trends": {
      "get": {
        "summary": "Historical device telemetry samples (plant-isolated)",
        "security": [{ "OperatorBearerAuth": [] }],
        "parameters": [
          { "name": "plantCode", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "deviceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 10, "maximum": 300 } }
        ],
        "responses": {
          "200": { "description": "Chronological device samples" },
          "404": { "description": "Device not found in authorized plant" }
        }
      }
    },
    "/api/v1/plants/{plantCode}/alarms": {
      "get": {
        "summary": "List plant alarms",
        "security": [{ "OperatorBearerAuth": [] }],
        "parameters": [
          { "name": "plantCode", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Alarm list" }
        }
      }
    },
    "/api/v1/plants/{plantCode}/alarms/{alarmId}/acknowledge": {
      "post": {
        "summary": "Acknowledge an active alarm (OPERATOR+)",
        "security": [{ "OperatorBearerAuth": [] }],
        "parameters": [
          { "name": "plantCode", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "alarmId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Alarm acknowledged" },
          "403": { "description": "Requires OPERATOR role" }
        }
      }
    },
    "/api/v1/plants/{plantCode}/alarms/{alarmId}/clear": {
      "post": {
        "summary": "Clear an alarm (OPERATOR+)",
        "security": [{ "OperatorBearerAuth": [] }],
        "parameters": [
          { "name": "plantCode", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "alarmId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Alarm cleared" },
          "403": { "description": "Requires OPERATOR role" }
        }
      }
    },
    "/api/v1/plants/{plantCode}/edge-credentials": {
      "get": {
        "summary": "List edge gateway credentials metadata (ADMIN)",
        "security": [{ "OperatorBearerAuth": [] }],
        "parameters": [
          { "name": "plantCode", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Edge credential metadata" }
        }
      },
      "post": {
        "summary": "Create or rotate an edge gateway or simulator credential (ADMIN)",
        "security": [{ "OperatorBearerAuth": [] }],
        "parameters": [
          { "name": "plantCode", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["edgeDeviceId", "label"],
                "properties": {
                  "edgeDeviceId": { "type": "string" },
                  "label": { "type": "string" },
                  "credentialType": { "type": "string", "enum": ["EDGE", "SIMULATION"], "default": "EDGE" },
                  "expiresInDays": { "type": "integer", "minimum": 1, "maximum": 365 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Issued credential (one-time raw secret returned)" }
        }
      }
    },
    "/api/v1/plants/{plantCode}/members": {
      "post": {
        "summary": "Assign or update operator role for a plant (ADMIN)",
        "security": [{ "OperatorBearerAuth": [] }],
        "parameters": [
          { "name": "plantCode", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Role assigned" }
        }
      }
    },
    "/api/v1/telemetry/ingest": {
      "post": {
        "summary": "Ingest telemetry batch from IoT Edge Gateway",
        "security": [
          {
            "EdgeCredentialId": [],
            "EdgeSecret": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "minLength": 4, "maxLength": 128 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TelemetryIngestRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Batch persisted or safely deduplicated (returns server-verified isSimulated & sourceType)" },
          "400": { "description": "Schema validation error" },
          "401": { "description": "Invalid edge credentials" },
          "403": { "description": "Cross-plant or edgeDeviceId mismatch" },
          "409": { "description": "Idempotency-Key reused with a different payload (IDEMPOTENCY_CONFLICT)" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    }
  }
}
